# Public repository: ignore everything by default.
*

# Keep only the portable project files.
!/.gitignore
!/.dockerignore
!/prompt.md
!/uvvenv.sh
!/README.md
!/sd15/
!/sd15/**
!/flux2/
!/flux2/**
!/shared/
!/shared/**
!/prompts/
!/prompts/.gitkeep
!/docker/
!/docker/**

# Keep runtime/generated files ignored even if patterns change later.
.DS_Store
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
ai-image-lab-work/
cache/
models/
outputs/
vendor/
prompts/*
!prompts/.gitkeep
dataset/
datasets/
chara/
lora/
*.safetensors
*.ckpt
*.pt
*.pth
!/shared/compat/jetson_torch_compat.pth
output/
outputs/
logs/
*.png
*.jpg
*.jpeg
*.webp
*.bmp
