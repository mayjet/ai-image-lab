ARG CUDA_IMAGE_TAG=12.8.1-cudnn-devel-ubuntu22.04
FROM nvidia/cuda:${CUDA_IMAGE_TAG}

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_NO_CACHE_DIR=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV AI_IMAGE_BACKEND=flux2
ENV AI_IMAGE_PLATFORM=cuda
ENV AI_IMAGE_CAPABILITY=training
ENV DIFFUSERS_REF=v0.40.0
ENV HF_HOME=/workspace/cache/huggingface
ENV XDG_CACHE_HOME=/workspace/cache
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

WORKDIR /tmp/build
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git python3 python3-pip python3-venv python3-dev \
    build-essential libgl1 libglib2.0-0 ffmpeg && \
    rm -rf /var/lib/apt/lists/*
RUN python3 -m pip install --upgrade pip setuptools wheel uv
RUN uv pip install --system --index-url https://download.pytorch.org/whl/cu128 \
    torch torchvision torchaudio

COPY docker/requirements.txt /tmp/build/requirements.txt
RUN uv pip install --system -r /tmp/build/requirements.txt
RUN uv pip install --system \
    "diffusers[torch]>=0.40.0,<0.41" \
    "transformers>=5,<6" \
    "accelerate>=1.10,<2" \
    "peft>=0.17,<1" \
    "huggingface-hub>=1.23,<2" \
    "bitsandbytes>=0.48,<1" torchao optimum-quanto prodigyopt
RUN python3 -c "from diffusers import Flux2KleinPipeline; import torch, transformers; print('FLUX.2 CUDA ready', torch.__version__, transformers.__version__)"

COPY docker/entrypoint.sh /usr/local/bin/ai-image-lab-entrypoint
COPY docker/check_environment.sh /usr/local/bin/check-ai-image-environment
RUN chmod +x /usr/local/bin/ai-image-lab-entrypoint /usr/local/bin/check-ai-image-environment

WORKDIR /workspace
EXPOSE 8888 6006
ENTRYPOINT ["/usr/local/bin/ai-image-lab-entrypoint"]
CMD ["python3", "-m", "jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root", "--NotebookApp.token=", "--NotebookApp.password="]
