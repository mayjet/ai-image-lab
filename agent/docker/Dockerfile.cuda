# image-agent CUDA Dockerfile
# Target: x86_64, NVIDIA GeForce RTX 2080, VRAM 8 GB
# Primary: FP16 inference only. No LoRA. No bind mounts. No Docker volumes.
#
# Tailscale is intentionally absent from this image. Borrowed-GPU mode downloads
# temporary static binaries at container runtime and deletes them with the container.

ARG CUDA_IMAGE_TAG=12.8.1-cudnn-devel-ubuntu24.04
FROM nvidia/cuda:${CUDA_IMAGE_TAG}

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_NO_CACHE_DIR=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# --- Cache / runtime paths (all under /workspace/agent/.runtime) ---
ENV HF_HOME=/workspace/agent/.runtime/cache/huggingface
ENV TRANSFORMERS_CACHE=/workspace/agent/.runtime/cache/transformers
ENV DIFFUSERS_CACHE=/workspace/agent/.runtime/cache/diffusers
ENV TORCH_HOME=/workspace/agent/.runtime/cache/torch
ENV XDG_CACHE_HOME=/workspace/agent/.runtime/cache/xdg
ENV REALESRGAN_CACHE=/workspace/agent/.runtime/models/realesrgan

ENV PYTORCH_ALLOC_CONF=expandable_segments:True
ENV JUPYTER_PORT=8888

WORKDIR /tmp/build

# --- System packages ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git python3 python3-pip python3-venv python3-dev \
    build-essential libgl1 libglib2.0-0 ffmpeg libsm6 libxext6 \
    && rm -rf /var/lib/apt/lists/*

# --- Python tooling ---
# Keep Ubuntu's pip/setuptools/wheel packages intact: Debian packages do not
# carry pip RECORD files and therefore cannot be safely uninstalled by pip.
RUN python3 -m pip install --break-system-packages --no-deps uv==0.7.13

# --- PyTorch (CUDA 12.8 wheel; driver 595 supports this runtime) ---
# BF16 / FP8 / NVFP4 are NOT enabled — RTX 2080 does not support them in hardware.
RUN uv pip install --system --break-system-packages \
    --index-url https://download.pytorch.org/whl/cu128 \
    "torch==2.9.1" \
    "torchvision==0.24.1" \
    "torchaudio==2.9.1"

# --- Diffusers stack ---
RUN uv pip install --system --break-system-packages \
    "diffusers==0.42.1" \
    "transformers==5.1.0" \
    "accelerate>=1.10,<2" \
    "bitsandbytes>=0.48,<1" \
    "huggingface-hub>=1.32,<2"

# --- Upscaler stack ---
RUN uv pip install --system --break-system-packages \
    "basicsr==1.4.2" \
    "realesrgan==0.3.0" \
    "facexlib==0.3.0" \
    "gfpgan==1.3.8"

# basicsr 1.4.2 imports a torchvision module removed in current torchvision.
RUN find /usr/local/lib -path '*/basicsr/data/degradations.py' -exec sed -i \
    's/from torchvision.transforms.functional_tensor import rgb_to_grayscale/from torchvision.transforms.functional import rgb_to_grayscale/' \
    {} +

# --- Other runtime deps ---
COPY agent/docker/requirements.txt /tmp/build/requirements.txt
RUN uv pip install --system --break-system-packages -r /tmp/build/requirements.txt

# --- Smoke test: imports only (no GPU required at build time) ---
RUN python3 -c "from transformers import Qwen3VLForConditionalGeneration; from diffusers import Flux2KleinPipeline; import torch, pydantic, langgraph; print('model imports ok')"

# --- Install image-agent package ---
COPY agent/ /workspace/agent/
RUN uv pip install --system --break-system-packages -e /workspace/agent/

# --- Runtime directories ---
RUN mkdir -p \
    /workspace/dataset \
    /workspace/agent/runs \
    /workspace/agent/.runtime/models \
    /workspace/agent/.runtime/cache/huggingface \
    /workspace/agent/.runtime/cache/transformers \
    /workspace/agent/.runtime/cache/torch \
    /workspace/agent/.runtime/cache/xdg \
    /workspace/agent/.runtime/cache/tmp \
    /workspace/agent/.runtime/logs \
    /workspace/agent/.runtime/offload

# Set the private temp path only after it exists.  Keeping this before apt would
# break package post-install scripts such as ca-certificates, which call mktemp.
ENV TMPDIR=/workspace/agent/.runtime/cache/tmp

# --- Entrypoint and utilities ---
COPY agent/docker/entrypoint.sh /usr/local/bin/image-agent-entrypoint
COPY agent/docker/check_environment.sh /usr/local/bin/check-image-agent-environment
RUN chmod +x /usr/local/bin/image-agent-entrypoint \
              /usr/local/bin/check-image-agent-environment

WORKDIR /workspace
EXPOSE 8888

ENTRYPOINT ["/usr/local/bin/image-agent-entrypoint"]
CMD ["jupyter"]
