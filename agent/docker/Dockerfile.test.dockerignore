# Build context filter for Dockerfile.test
# Overrides root .dockerignore for this Dockerfile only.

# Exclude everything first
*

# Include only agent/ source files
!agent/
!agent/**

# Exclude runtime state and private content
agent/runs/
agent/.runtime/
agent/prompts/*
agent/**/__pycache__/
agent/**/*.pyc
agent/**/.ipynb_checkpoints/

# Exclude model files and generated content
agent/**/*.safetensors
agent/**/*.ckpt
agent/**/*.pt
agent/**/*.pth
agent/**/*.png
agent/**/*.jpg
agent/**/*.jpeg
