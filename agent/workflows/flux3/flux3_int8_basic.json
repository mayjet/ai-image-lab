{
  "_note": "FLUX.3 Klein INT8 ConvRot ComfyUI workflow template.",
  "_status": "EXPERIMENTAL — RTX 2080 compatibility unverified.",
  "_license": "FLUX Kommunity License — review at https://bfl.ai before use.",
  "_required_files": [
    "flux3-image-klein-int8-convrot.safetensors",
    "qwen3vl_4b_int8_convrot.safetensors",
    "flux2-vae.safetensors"
  ],
  "_note2": "Replace placeholder node IDs with actual ComfyUI workflow API IDs after testing.",
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "flux3-image-klein-int8-convrot.safetensors"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "PLACEHOLDER — will be replaced by generation_caption from Qwen planner",
      "clip": ["1", 1]
    }
  },
  "3": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 512,
      "height": 512,
      "batch_size": 1
    }
  },
  "4": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 20,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["2", 0],
      "latent_image": ["3", 0]
    }
  },
  "5": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["4", 0],
      "vae": ["1", 2]
    }
  },
  "6": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["5", 0],
      "filename_prefix": "flux3_output"
    }
  }
}
